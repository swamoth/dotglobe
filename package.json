{
  "name": "dotglobe",
  "version": "0.1.0",
  "description": "Dot-matrix globe in WebGL2. One quad, one ray-cast sphere, no three.js.",
  "keywords": [
    "globe",
    "webgl2",
    "webgl",
    "dot",
    "fibonacci",
    "earth",
    "map"
  ],
  "license": "MIT",
  "author": "Swagat Mohanty",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/dotglobe.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/dotglobe.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./land": {
      "types": "./dist/land.d.ts",
      "default": "./dist/land.js"
    }
  },
  "scripts": {
    "build": "node bench/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:size": "node bench/size.mjs",
    "bench:frame": "node bench/frame.mjs",
    "bench": "npm run bench:size && npm run bench:frame",
    "demo": "node bench/build.mjs && node bench/serve.mjs 5173",
    "bench:compare": "node bench/compare.mjs",
    "bake:land": "node scripts/bake-land.mjs 1024 512 write"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
